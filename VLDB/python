#!/usr/bin/env bash
# Usage: ./run.sh dice/experiments_revision/offline_runtime/plot.py [extra-args]

source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate ../conda_envs/semanticsortenv

# ── derive a Python-module name from the first CLI arg ──────────────
if [ $# -lt 1 ]; then
    echo "Give me a *.py path to run, e.g. dice/…/plot.py"
    exit 1
fi

script_path="$1"; shift                      # pop the path off "$@"
module_name=${script_path%.py}               # drop the .py suffix
module_name=${module_name#./}                # drop leading "./"
module_name=${module_name//\//.}             # / → .

# ── run & time it ───────────────────────────────────────────────────
start_time=$(date +%s)

printf '\n%.0s' {1..10}                      # print 10 blank lines
echo "__________starting python__________"

python -m "$module_name" "$@"                # pass any extra args verbatim
PYTHON_EXIT_STATUS=$?

end_time=$(date +%s)
elapsed_time=$(( (end_time - start_time) / 60 ))
echo "Execution time: $elapsed_time minutes"

exit $PYTHON_EXIT_STATUS
